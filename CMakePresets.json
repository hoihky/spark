{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug (SparkDemo)",
      "description": "Default CLion profile: SparkDemo + SparkGameplay",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SPARK_BUILD_DEMO": "ON",
        "SPARK_BUILD_GAMEPLAY": "ON"
      }
    },
    {
      "name": "editor-debug",
      "displayName": "Debug (SparkEditor)",
      "description": "Shared SparkEngine + editor shell (no demos in engine lib)",
      "binaryDir": "${sourceDir}/cmake-build-editor",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SPARK_BUILD_ENGINE_SHARED": "OFF",
        "SPARK_BUILD_ENGINE_DEMOS": "OFF",
        "SPARK_BUILD_EDITOR": "ON",
        "SPARK_BUILD_SPARK_EDITOR": "ON",
        "SPARK_BUILD_DEMO": "OFF",
        "SPARK_BUILD_GAMEPLAY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "editor-debug",
      "configurePreset": "editor-debug"
    }
  ]
}
